
erDiagram
    DEPARTMENT ||--o{ STUDENT : "employs/enrolls"
    ADMINISTRATOR ||--o{ OFFICIAL_SANCTION : "finalizes/overrides"
    ADMINISTRATOR ||--o{ AUDIT_LOG : "triggers(admin_actions)"
    SSC_OFFICER ||--o{ EVENT : "creates/manages"
    SSC_OFFICER ||--o{ ATTENDANCE_RECORD : "confirms/flags"
    SSC_OFFICER ||--o{ RECOMMENDED_SANCTION : "recommends"
    SSC_OFFICER ||--o{ AUDIT_LOG : "triggers(officer_actions)"
    STUDENT ||--o{ STUDENT_CHECK_IN_CODE : "assigned"
    STUDENT ||--o{ PHOTO_RECORD : "enrolled"
    STUDENT ||--o{ ATTENDANCE_RECORD : "records"
    STUDENT ||--o{ RECOMMENDED_SANCTION : "subject_of"
    STUDENT ||--o{ AUDIT_LOG : "subject_of"
    EVENT ||--o{ ATTENDANCE_RECORD : "tracks"
    EVENT ||--o{ AUDIT_LOG : "tracks"
    RECOMMENDED_SANCTION ||--o| OFFICIAL_SANCTION : "converted_to"

    ADMINISTRATOR {
        int admin_id PK
        string username UK
        string password_hash
        string status
    }
    SSC_OFFICER {
        int officer_id PK
        string username UK
        string password_hash
        string full_name
        string status
    }
    DEPARTMENT {
        int department_id PK
        string department_name
    }
    STUDENT {
        int student_id PK
        int department_id FK
        string username UK
        string password_hash
        string full_name
        string status
    }
    EVENT {
        int event_id PK
        int officer_id FK
        string event_name
        datetime event_date
        string venue
        boolean is_mandatory
        string status
    }
    ATTENDANCE_RECORD {
        int attendance_id PK
        int student_id FK
        int event_id FK
        int officer_id FK
        string status
        string check_in_method
        datetime timestamp
    }
    STUDENT_CHECK_IN_CODE {
        int code_id PK
        int student_id FK
        string qr_token UK
        boolean is_active
        datetime issued_at
        datetime rotated_at
    }
    PHOTO_RECORD {
        int photo_id PK
        int student_id FK
        string image_url
        boolean is_active
        datetime enrolled_at
    }
    RECOMMENDED_SANCTION {
        int recommendation_id PK
        int student_id FK
        int officer_id FK
        string reason
        string severity
        string status
        datetime recommended_at
    }
    OFFICIAL_SANCTION {
        int sanction_id PK
        int recommendation_id FK
        int admin_id FK
        string sanction_type
        datetime finalized_at
        string admin_notes
    }
    AUDIT_LOG {
        int log_id PK
        string action_type
        int student_id FK
        int event_id FK
        int officer_id FK
        int admin_id FK
        string check_in_method
        string photo_check_result
        datetime timestamp
    }
