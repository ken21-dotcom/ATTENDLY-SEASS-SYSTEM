  <diagram name="Page-1" id="H2qqaK5sqif5EWIpnTOj">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Relationships\n    DEPARTMENT ||--o{ STUDENT : \&quot;enrolls\&quot;\n    \n    ADMINISTRATOR ||--o{ FINGERPRINT_RECORD : \&quot;enrolls/re-enrolls\&quot;\n    ADMINISTRATOR ||--o{ OFFICIAL_SANCTION : \&quot;finalizes/overrides\&quot;\n    ADMINISTRATOR ||--o{ AUDIT_LOG : \&quot;triggers(admin_actions)\&quot;\n    \n    SSC_OFFICER ||--o{ EVENT : \&quot;creates/manages\&quot;\n    SSC_OFFICER ||--o{ ATTENDANCE_RECORD : \&quot;confirms/flags\&quot;\n    SSC_OFFICER ||--o{ RECOMMENDED_SANCTION : \&quot;recommends\&quot;\n    SSC_OFFICER ||--o{ AUDIT_LOG : \&quot;triggers(officer_actions)\&quot;\n    \n    STUDENT ||--o{ FINGERPRINT_RECORD : \&quot;has\&quot;\n    STUDENT ||--o{ ATTENDANCE_RECORD : \&quot;records\&quot;\n    STUDENT ||--o{ RECOMMENDED_SANCTION : \&quot;subject_of\&quot;\n    STUDENT ||--o{ AUDIT_LOG : \&quot;subject_of\&quot;\n    \n    EVENT ||--o{ ATTENDANCE_RECORD : \&quot;tracks\&quot;\n    EVENT ||--o{ AUDIT_LOG : \&quot;tracks\&quot;\n    \n    RECOMMENDED_SANCTION ||--o| OFFICIAL_SANCTION : \&quot;converted_to\&quot;\n\n    %% Entities and Attributes\n    ADMINISTRATOR {\n        int admin_id PK\n        string username UK\n        string password_hash\n        string full_name\n        string status \&quot;active/inactive\&quot;\n    }\n\n    SSC_OFFICER {\n        int officer_id PK\n        string username UK\n        string password_hash\n        string full_name\n        string status \&quot;active/inactive/pending\&quot;\n    }\n\n    DEPARTMENT {\n        int department_id PK\n        string department_name\n    }\n\n    STUDENT {\n        int student_id PK\n        int department_id FK\n        string username UK\n        string password_hash\n        string full_name\n        string status \&quot;active/inactive\&quot;\n    }\n\n    EVENT {\n        int event_id PK\n        int officer_id FK\n        string event_name\n        datetime event_date\n        string venue\n        boolean is_mandatory \&quot;FR-008\&quot;\n        string status \&quot;scheduled/cancelled/completed\&quot;\n    }\n\n    ATTENDANCE_RECORD {\n        int attendance_id PK\n        int student_id FK\n        int event_id FK\n        int officer_id FK\n        string status \&quot;confirmed/flagged\&quot; \&quot;FR-005\&quot;\n        string check_in_method \&quot;fingerprint\&quot;\n        datetime timestamp\n    }\n\n    FINGERPRINT_RECORD {\n        int fingerprint_id PK\n        int student_id FK\n        int enrolled_by_admin_id FK \&quot;FR-014\&quot;\n        string template_hash \&quot;encrypted biometric data\&quot;\n        boolean is_active \&quot;FR-003\&quot;\n        datetime enrolled_at \&quot;FR-014\&quot;\n    }\n\n    RECOMMENDED_SANCTION {\n        int recommendation_id PK\n        int student_id FK\n        int officer_id FK\n        string reason\n        string severity\n        string status \&quot;pending/reviewed\&quot; \&quot;FR-011\&quot;\n        datetime recommended_at\n    }\n\n    OFFICIAL_SANCTION {\n        int sanction_id PK\n        int recommendation_id FK\n        int admin_id FK\n        string sanction_type \&quot;Warning/Probation\&quot; \&quot;FR-015\&quot;\n        datetime finalized_at\n        string admin_notes\n    }\n\n    AUDIT_LOG {\n        int log_id PK\n        string action_type \&quot;Fingerprint_Enroll/CheckIn/Sanction\&quot;\n        int student_id FK\n        int event_id FK\n        int officer_id FK\n        int admin_id FK\n        string details \&quot;JSON or text description\&quot;\n        datetime timestamp\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="pbHrBGNB97D2qLAcDASd-1">
